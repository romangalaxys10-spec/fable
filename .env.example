# Fable Environment Variables Example
PORT=3000
HOST=0.0.0.0

# Optional Hugging Face Token for higher rate limits on discovery
HF_TOKEN=

# Optional Gemini API key for intelligent task synthesis & assistance
GEMINI_API_KEY=

# Optional Runway API key for video generation
RUNWAY_API_KEY=

# Optional custom corpus location (defaults to ~/.fable/corpus.jsonl)
FABLE_CORPUS=
